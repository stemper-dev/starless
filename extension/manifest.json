{
  "manifest_version": 3,
  "name": "Starless",
  "version": "1.0.0",
  "description": "Hide GTA spoilers from your feeds.",
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://www.linkedin.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "css": [
        "hide.css"
      ],
      "js": [
        "matcher.js",
        "sites.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
