{
  "manifest_version": 3,
  "name": "Starless",
  "version": "1.0.0",
  "description": "Hide GTA spoilers from your feeds.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Starless — Hide GTA spoilers",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://www.linkedin.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "css": [
        "hide.css"
      ],
      "js": [
        "matcher.js",
        "sites.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
